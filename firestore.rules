rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile: Only accessible by the owner
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // User Playlists subcollection: Strictly owner-scoped
      match /playlists/{playlistId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }
    }

    // Couple Link: Shared pairing for partners
    match /couples/{coupleCode} {
      allow get: if true;
      allow list: if false;
      allow create, update: if true;
      allow delete: if isSignedIn();
    }

    // Realtime Sync Rooms (Supports Vercel & serverless deployments)
    match /rooms/{roomId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if true;
    }
  }
}
